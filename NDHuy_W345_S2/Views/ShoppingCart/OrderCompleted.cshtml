@model int
@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card card-custom text-center">
            <div class="card-body py-5">
                <!-- Icon thành công -->
                <div class="mb-4">
                    <i class="bi bi-check-circle text-success" style="font-size: 80px;"></i>
                </div>

                <h2 class="fw-bold mb-3">Đặt hàng thành công!</h2>

                <p class="text-muted mb-4">
                    Cảm ơn bạn đã mua hàng tại Siêu Công Nghệ .
                    Đơn hàng của bạn đã được ghi nhận và đang được xử lý.
                </p>

                <div class="bg-light rounded-4 p-4 mb-4">
                    <div class="text-muted small mb-2">Mã đơn hàng</div>
                    <h3 class="fw-bold text-primary mb-0">#@Model</h3>
                </div>

                <p class="text-muted small mb-4">
                    Vui lòng giữ mã đơn hàng để tiện theo dõi.
                    Chúng tôi sẽ sớm liên hệ xác nhận đơn hàng của bạn.
                </p>

                <div class="d-flex gap-2 justify-content-center">
                    <a asp-controller="Product" asp-action="Index"
                       class="btn buy-btn btn-lg">
                        <i class="bi bi-bag me-2"></i>Tiếp tục mua sắm
                    </a>
                    <a asp-controller="Home" asp-action="Index"
                       class="btn btn-outline-secondary btn-lg">
                        <i class="bi bi-house me-2"></i>Về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>