@model IEnumerable<NDHuy_W345_S2.Models.Product>
@using NDHuy_W345_S2.Extensions
@using NDHuy_W345_S2.Models

@{
    ViewData["Title"] = "Trang chủ";
    var categories = ViewBag.Categories as List<Category>;
    int? selectedCategoryId = ViewBag.SelectedCategoryId;
    var selectedCategoryName = selectedCategoryId.HasValue && categories != null
        ? categories.FirstOrDefault(c => c.Id == selectedCategoryId.Value)?.Name
        : null;
    int numOfQuantity = 1;

    var currentCart = Context.GetCurrentCart();
    var cartItemCount = currentCart.TotalItems;
}

@functions {
    string GetCategoryIcon(string categoryName)
    {
        return categoryName switch
        {
            "Điện thoại" => "bi-phone",
            "Laptop" => "bi-laptop",
            "Máy tính bảng" => "bi-tablet",
            "Tai nghe" => "bi-headphones",
            "Phụ kiện" => "bi-usb-plug",
            "Đồng hồ thông minh" => "bi-smartwatch",
            _ => "bi-grid"
        };
    }
}

<div class="container-fluid px-3">

    <!-- LEFT SIDEBAR -->
    <div class="category-bar mb-4">

        <a asp-controller="Home"
           asp-action="Index"
           class="category-chip @(selectedCategoryId == null ? "active-chip" : "")">
            <i class="bi bi-grid"></i>
            <span>Tất cả</span>
        </a>

        @if (categories != null)
        {
            @foreach (var cat in categories)
            {
                <a asp-controller="Home"
                   asp-action="Index"
                   asp-route-categoryId="@cat.Id"
                   class="category-chip @(selectedCategoryId == cat.Id ? "active-chip" : "")">

                    <i class="bi @GetCategoryIcon(cat.Name)"></i>
                    <span>@cat.Name</span>

                </a>
            }
        }

    </div>

    <!-- CENTER CONTENT -->
    <div class="col-12">

        <!-- HERO -->
        <div class="hero-modern mb-5">

            <div class="hero-left">
                <span class="hero-tag">NEW COLLECTION 2025</span>

                <h1>
                    Công nghệ<br>
                    đẳng cấp mới
                </h1>

                <p>
                    Hơn 1000+ sản phẩm chính hãng với mức giá hấp dẫn.
                </p>

                <a href="#products" class="btn btn-dark btn-lg">
                    Khám phá ngay
                </a>
            </div>

        </div>

        <!-- CAROUSEL -->
        <div id="homeCarousel" class="carousel slide mb-4" data-bs-ride="carousel">

            <div class="carousel-indicators">
                <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="0" class="active"></button>
                <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="1"></button>
                <button type="button" data-bs-target="#homeCarousel" data-bs-slide-to="2"></button>
            </div>

            <div class="carousel-inner rounded-4 overflow-hidden shadow-sm">

                <div class="carousel-item active">
                    <img src="https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?q=80&w=1200"
                         class="d-block w-100"
                         style="height:320px;object-fit:cover;"
                         alt="Slide 1">

                    <div class="carousel-caption">
                        <div class="caption-box">
                            <h3>Nova X Pro 256GB</h3>
                            <p>Màn hình AMOLED, hiệu năng mạnh mẽ.</p>
                        </div>
                    </div>
                </div>

                <div class="carousel-item">
                    <img src="https://images.unsplash.com/photo-1496181133206-80ce9b88a853?q=80&w=1200"
                         class="d-block w-100"
                         style="height:320px;object-fit:cover;"
                         alt="Slide 2">

                    <div class="carousel-caption">
                        <div class="caption-box">
                            <h3>Zenith Book 14</h3>
                            <p>Laptop mỏng nhẹ dành cho công việc.</p>
                        </div>
                    </div>
                </div>

                <div class="carousel-item">
                    <img src="https://images.unsplash.com/photo-1505740420928-5e560c06d30e?q=80&w=1200"
                         class="d-block w-100"
                         style="height:320px;object-fit:cover;"
                         alt="Slide 3">

                    <div class="carousel-caption">
                        <div class="caption-box">
                            <h3>SoundMax ANC Pro</h3>
                            <p>Tai nghe chống ồn cao cấp.</p>
                        </div>
                    </div>
                </div>

            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#homeCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>

            <button class="carousel-control-next" type="button" data-bs-target="#homeCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>

        @if (selectedCategoryId.HasValue && selectedCategoryName != null)
        {
            <div class="d-flex justify-content-between align-items-center mb-4">

                <h5 class="fw-bold mb-0">
                    <i class="bi bi-funnel text-primary me-2"></i>
                    @selectedCategoryName
                    <span class="text-muted fw-normal">
                        (@Model.Count() sản phẩm)
                    </span>
                </h5>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="text-decoration-none">
                    Xóa bộ lọc
                </a>
            </div>
        }

        <!-- PRODUCTS -->
        <div id="products" class="row g-4">

            @if (Model != null && Model.Any())
            {
                @foreach (var product in Model)
                {
                    <div class="col-lg-4 col-md-6">

                        <div class="card product-card border-0 h-100">

                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl"
                                     class="card-img-top"
                                     style="height:240px;object-fit:cover;"
                                     alt="@product.Name" />
                            }
                            else
                            {
                                <div class="card-img-top bg-light d-flex justify-content-center align-items-center"
                                     style="height:240px;">
                                    <i class="bi bi-image text-muted" style="font-size:50px;"></i>
                                </div>
                            }

                            <div class="card-body d-flex flex-column">

                                <span class="product-badge mb-3">
                                    @product.Category?.Name
                                </span>

                                <h5 class="fw-bold mb-2">
                                    @product.Name
                                </h5>

                                <p class="text-muted small flex-grow-1">
                                    @product.Description
                                </p>

                                <div class="product-price mb-3">
                                    @String.Format("{0:N0}đ", product.Price)
                                </div>

                                <div class="d-flex gap-2">

                                    <a asp-controller="Product"
                                       asp-action="Display"
                                       asp-route-id="@product.Id"
                                       class="btn btn-outline-primary w-50">
                                        Chi tiết
                                    </a>

                                    <form asp-controller="ShoppingCart"
                                        asp-action="AddToCart" method="post" class="w-50">
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <input type="hidden" name="quantity" value="1" />
                                        <button type="submit" class="btn buy-btn w-100" >
                                            <i class="bi bi-cart-plus me-1"></i>
                                                Thêm vào Giỏ Hàng </button>    
                                    </form>

                                </div>

                            </div>

                        </div>

                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <i class="bi bi-box-seam text-muted"
                       style="font-size:70px;"></i>

                    <p class="mt-3 text-muted">
                        Chưa có sản phẩm nào
                    </p>
                </div>
            }

        </div>
    </div>


</div>

@section Styles {

    <style>

        body {
            background: #f8f9fb;
        }

        .hero-modern {
            min-height: 320px;
            border-radius: 30px;
            padding: 60px;
            background: linear-gradient( 135deg, #111827, #1f2937 );
            color: white;
            display: flex;
            align-items: center;
            margin-bottom: 40px;
        }

        .hero-tag {
            background: rgba(255,255,255,.1);
            padding: 8px 18px;
            border-radius: 50px;
            display: inline-block;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .hero-modern h1 {
            font-size: 3.5rem;
            font-weight: 800;
            line-height: 1.1;
        }

        .hero-modern p {
            color: #d1d5db;
            margin: 20px 0;
            max-width: 500px;
        }

        .category-bar {
            display: flex;
            gap: 15px;
            overflow-x: auto;
            margin-bottom: 30px;
            padding-bottom: 10px;
        }

        .category-chip {
            text-decoration: none;
            color: #333;
            background: white;
            border: 1px solid #eee;
            border-radius: 20px;
            padding: 12px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
            transition: .3s;
        }

            .category-chip:hover {
                transform: translateY(-4px);
                color: #ff6b00;
            }

        .active-chip {
            background: #ff6b00;
            color: white !important;
            border-color: #ff6b00;
        }

        .product-card {
            border-radius: 24px;
            overflow: hidden;
            background: white;
            transition: .35s;
            border: 1px solid #ececec;
        }

            .product-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 25px 50px rgba(0,0,0,.12);
            }

            .product-card img {
                background: #fafafa;
                transition: .4s;
            }

            .product-card:hover img {
                transform: scale(1.05);
            }

        .product-badge {
            background: #fff3e8;
            color: #ff6b00;
            border-radius: 50px;
            padding: 8px 15px;
            font-size: 12px;
            font-weight: 700;
            width: fit-content;
        }

        .product-price {
            font-size: 1.7rem;
            color: #dc2626;
            font-weight: 800;
        }

        .btn-gradient {
            background: #111827;
            border: none;
            color: white;
        }

            .btn-gradient:hover {
                background: #000;
                color: white;
            }

        .carousel-inner {
            border-radius: 24px;
            overflow: hidden;
        }

        .caption-box {
            background: rgba(0,0,0,.55);
            padding: 15px 20px;
            border-radius: 15px;
        }

        .sticky-sidebar {
            position: sticky;
            top: 20px;
        }

        .card-custom {
            border-radius: 24px;
        }
    </style>

}
```
