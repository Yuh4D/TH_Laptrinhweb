@model NDHuy_W345_S2.Models.Product

@{
    ViewData["Title"] = $"Cập nhật - {Model.Name}";
    var imageCount = Model.Images?.Count ?? 0;
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

<h2 class="fw-bold mb-4">
    <i class="bi bi-pencil-square text-primary me-2"></i>Cập nhật sản phẩm
</h2>

<div class="row g-4">
    <!-- Form cập nhật -->
    <div class="col-lg-7">
        <div class="card card-custom">
            <div class="card-body p-4">
                <form asp-action="Update" method="post" enctype="multipart/form-data">
                    <input asp-for="Id" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">
                            <i class="bi bi-tag me-1"></i>Tên sản phẩm
                        </label>
                        <input asp-for="Name" class="form-control form-control-lg" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold">
                                <i class="bi bi-cash me-1"></i>Giá bán (VNĐ)
                            </label>
                            <input asp-for="Price" class="form-control form-control-lg" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-folder me-1"></i>Danh mục
                            </label>
                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.Categories"
                                    class="form-select form-select-lg">
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">
                            <i class="bi bi-file-text me-1"></i>Mô tả sản phẩm
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-image me-1"></i>Ảnh đại diện
                        </label>
                        <div class="mb-2">
                            @if (!string.IsNullOrEmpty(Model.ImageUrl))
                            {
                                <img src="@Model.ImageUrl" id="currentImage"
                                     class="img-thumbnail mb-2"
                                     style="max-width:200px; max-height:200px; object-fit:cover;"
                                     alt="Ảnh hiện tại" />
                            }
                        </div>
                        <input type="file" name="imageUrl" id="imageInput"
                               class="form-control" accept="image/*" />
                        <div class="form-text">Để trống nếu không muốn thay đổi ảnh đại diện</div>
                        <!-- Preview ảnh mới -->
                        <img id="newImagePreview" class="img-preview mt-2" style="max-width:200px;" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn buy-btn btn-lg flex-grow-1">
                            <i class="bi bi-check-lg me-2"></i>Cập nhật
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-x-lg me-1"></i>Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Cột phải: Quản lý ảnh + thông tin -->
    <div class="col-lg-5">
        <div class="sticky-sidebar">

            <!-- Card: Quản lý ảnh gallery -->
            <div class="card card-custom mb-3">
                <div class="card-body p-4 text-center">
                    <i class="bi bi-images text-primary" style="font-size:48px;"></i>
                    <h5 class="fw-bold mt-2">Thư viện ảnh</h5>
                    <p class="text-muted small mb-3">
                        @if (imageCount > 0)
                        {
                            <span>Đang có <strong>@imageCount ảnh</strong> trong thư viện</span>
                        }
                        else
                        {
                            <span>Chưa có ảnh nào trong thư viện</span>
                        }
                    </p>
                    <a asp-action="AddImage" asp-route-id="@Model.Id"
                       class="btn btn-outline-primary btn-lg w-100">
                        <i class="bi bi-plus-circle me-2"></i>Quản lý ảnh
                    </a>
                </div>
            </div>

            <!-- Card: Thông tin thêm -->
            <div class="card card-custom">
                <div class="card-body p-3">
                    <h6 class="fw-bold mb-2">
                        <i class="bi bi-info-circle text-muted me-2"></i>Thông tin
                    </h6>
                    <p class="small text-muted mb-0">
                        Ảnh đại diện là ảnh hiển thị chính trong danh sách sản phẩm.
                        Để thêm nhiều ảnh cho gallery, nhấn vào nút "Quản lý ảnh".
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            // Preview ảnh đại diện mới khi chọn file
            $('#imageInput').on('change', function () {
                var file = this.files[0];
                var $preview = $('#newImagePreview');

                if (file && file.type.match(/^image\//)) {
                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $preview.attr('src', e.target.result)
                                .css('display', 'block');
                    };
                    reader.readAsDataURL(file);
                } else {
                    $preview.css('display', 'none').attr('src', '');
                }
            });
        });
    </script>
}
