@model IEnumerable<NDHuy_W345_S2.Models.Product>

@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">
        <i class="bi bi-box-seam text-primary me-2"></i>Danh sách sản phẩm
    </h2>
    <a asp-action="Add" class="btn buy-btn">
        <i class="bi bi-plus-lg me-1"></i>Thêm sản phẩm
    </a>
</div>

<div class="card card-custom">
    <div class="card-body p-3">
        <div class="table-responsive">
            <table id="productTable" class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width:90px;">Ảnh</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>Giá</th>
                        <th style="width:200px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" class="img-thumb" alt="@item.Name" />
                                }
                                else
                                {
                                    <div class="img-thumb d-flex align-items-center justify-content-center bg-light">
                                        <i class="bi bi-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td class="fw-semibold">@item.Name</td>
                            <td>
                                <span class="badge bg-primary rounded-pill">@item.Category?.Name</span>
                            </td>
                            <td class="text-danger fw-bold">@String.Format("{0:N0}đ", item.Price)</td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Display" asp-route-id="@item.Id"
                                       class="btn btn-outline-primary btn-sm" title="Chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Update" asp-route-id="@item.Id"
                                       class="btn btn-outline-warning btn-sm" title="Sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id"
                                       class="btn btn-outline-danger btn-sm" title="Xóa">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#productTable').DataTable({
                language: {
                    search: "Tìm kiếm:",
                    lengthMenu: "Hiển thị _MENU_ dòng",
                    info: "Hiển thị _START_ đến _END_ của _TOTAL_ sản phẩm",
                    infoEmpty: "Không có sản phẩm nào",
                    infoFiltered: "(lọc từ _MAX_ sản phẩm)",
                    zeroRecords: "Không tìm thấy sản phẩm phù hợp",
                    paginate: {
                        first: "Đầu",
                        last: "Cuối",
                        next: "Sau",
                        previous: "Trước"
                    },
                    emptyTable: "Chưa có sản phẩm nào trong danh sách"
                },
                order: [[1, 'asc']], // Sắp xếp theo tên A-Z
                pageLength: 10,
                lengthMenu: [[5, 10, 25, -1], [5, 10, 25, "Tất cả"]],
                responsive: true,
                columnDefs: [
                    { orderable: false, targets: [0, 4] } // Không sắp xếp cột ảnh và thao tác
                ]
            });
        });
    </script>
}
