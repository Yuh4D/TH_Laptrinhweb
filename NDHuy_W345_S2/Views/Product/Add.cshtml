@model NDHuy_W345_S2.Models.Product

@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

<h2 class="fw-bold mb-4">
    <i class="bi bi-plus-circle text-primary me-2"></i>Thêm sản phẩm mới
</h2>

<div class="row g-4">
    <!-- Cột trái: Form nhập liệu -->
    <div class="col-lg-7">
        <div class="card card-custom">
            <div class="card-body p-4">
                <form asp-action="Add" method="post" enctype="multipart/form-data" id="addProductForm">

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label fw-semibold">
                            <i class="bi bi-tag me-1"></i>Tên sản phẩm
                        </label>
                        <input asp-for="Name" class="form-control form-control-lg" placeholder="Nhập tên sản phẩm..." />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Price" class="form-label fw-semibold">
                                <i class="bi bi-cash me-1"></i>Giá bán (VNĐ)
                            </label>
                            <input asp-for="Price" class="form-control form-control-lg" placeholder="0" />
                            <span asp-validation-for="Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">
                                <i class="bi bi-folder me-1"></i>Danh mục
                            </label>
                            <select asp-for="CategoryId"
                                    asp-items="ViewBag.Categories"
                                    class="form-select form-select-lg">
                                <option value="">-- Chọn danh mục --</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold">
                            <i class="bi bi-file-text me-1"></i>Mô tả sản phẩm
                        </label>
                        <textarea asp-for="Description" class="form-control" rows="5"
                                  placeholder="Nhập mô tả chi tiết về sản phẩm..."></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-image me-1"></i>Hình ảnh đại diện
                        </label>
                        <input type="file" name="imageUrl" id="imageInput"
                               class="form-control form-control-lg"
                               accept="image/*" />
                        <div class="form-text">Chọn ảnh đại diện cho sản phẩm (jpg, png, webp)</div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn buy-btn btn-lg flex-grow-1">
                            <i class="bi bi-check-lg me-2"></i>Lưu sản phẩm
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                            <i class="bi bi-x-lg me-1"></i>Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Cột phải: Preview ảnh -->
    <div class="col-lg-5">
        <div class="sticky-sidebar">
            <div class="card card-custom">
                <div class="card-body text-center p-4">
                    <h5 class="fw-bold mb-3">
                        <i class="bi bi-eye me-2"></i>Xem trước ảnh
                    </h5>

                    <!-- Khu vực preview -->
                    <div id="previewContainer" class="mb-3">
                        <img id="imgPreview"
                             class="img-preview mx-auto d-block"
                             style="max-width:100%; max-height:350px; display:none;"
                             alt="Preview" />
                        <div id="noImagePlaceholder"
                             class="border border-2 border-dashed rounded-4 d-flex flex-column align-items-center justify-content-center text-muted"
                             style="min-height:300px; border-style:dashed !important;">
                            <i class="bi bi-image" style="font-size:64px;"></i>
                            <p class="mt-3 mb-1 fw-semibold">Chưa chọn ảnh</p>
                            <p class="small">Ảnh sẽ hiển thị ở đây sau khi chọn</p>
                        </div>
                    </div>

                    <!-- Thông tin file -->
                    <div id="fileInfo" class="small text-muted" style="display:none;">
                        <div class="bg-light rounded-3 p-2 d-inline-block">
                            <span id="fileName"></span>
                            <span class="mx-1">•</span>
                            <span id="fileSize"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .border-dashed {
            border-style: dashed !important;
        }
    </style>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        $(document).ready(function () {
            $('#imageInput').on('change', function () {
                var file = this.files[0];
                var $preview = $('#imgPreview');
                var $placeholder = $('#noImagePlaceholder');
                var $fileInfo = $('#fileInfo');

                if (file) {
                    // Kiểm tra kiểu file
                    if (!file.type.match(/^image\//)) {
                        alert('Vui lòng chọn file ảnh hợp lệ!');
                        $(this).val('');
                        return;
                    }

                    var reader = new FileReader();
                    reader.onload = function (e) {
                        $preview.attr('src', e.target.result)
                                .css('display', 'block');
                        $placeholder.hide();
                    };
                    reader.readAsDataURL(file);

                    // Hiển thị thông tin file
                    $('#fileName').text(file.name);
                    $('#fileSize').text(formatFileSize(file.size));
                    $fileInfo.show();
                } else {
                    $preview.css('display', 'none').attr('src', '');
                    $placeholder.show();
                    $fileInfo.hide();
                }
            });

            function formatFileSize(bytes) {
                if (bytes < 1024) return bytes + ' B';
                if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
                return (bytes / 1048576).toFixed(1) + ' MB';
            }
        });
    </script>
}
